{
  "expo": {
    "name": "stamp_bound",
    "slug": "stamp_bound",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "stampbound",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/stamp_bound",
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
